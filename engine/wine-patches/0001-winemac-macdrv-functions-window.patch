+
+/***********************************************************************
+ *              macdrv_dxmt_window_content_view
+ *
+ * GTAV-Mac project: DXMT compatibility. Returns the WineContentView that
+ * fills a Wine window, so DXMT can attach its Metal view to it.
+ */
+WineContentView *macdrv_dxmt_window_content_view(WineWindow *window)
+{
+    __block WineContentView *view = nil;
+
+    if (!window) return nil;
+
+    OnMainThread(^{
+        NSView *content = [window contentView];
+        if ([content isKindOfClass:[WineContentView class]])
+            view = (WineContentView*)content;
+    });
+
+    return view;
+}
