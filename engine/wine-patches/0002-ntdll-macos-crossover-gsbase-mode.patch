 extern void _thread_set_tsd_base(uint64_t);
+
+/* MacX (CrossOver mode): GSBASE always points at the pthread TSD, so native macOS code
+ * (including Apple's D3DMetal, which PE code calls directly) keeps working. Windows code reaches
+ * its TEB through the TSD slots Apple reserves for Wine: Self (0x30) and TLS (0x58), plus the PEB in
+ * slot 12 (0x60), which is swapped with libc's value at every Windows/Unix transition. */
+static inline void mac_mirror_teb_slots( void *teb )
+{
+    __asm__ volatile( "movq %0,%%gs:0x30" :: "r" (teb) );
+    __asm__ volatile( "movq %0,%%gs:0x58" :: "r" (((void **)teb)[0x58 / 8]) );
+}
+
+/* Slot 12 (0x60) is libc's localtime buffer key, but protected Windows code reads the PEB from gs:0x60.
+ * Swap it: PEB while Windows code runs, libc's value (kept in TEB+0x348) while Unix code runs. */
+static inline void *mac_tsd12(void)
+{
+    void *v;
+    __asm__ volatile( "movq %%gs:0x60,%0" : "=r" (v) );
+    return v;
+}
+static inline void mac_slot12_to_windows( void *teb )
+{
+    void *peb = ((void **)teb)[0x60 / 8], *cur = mac_tsd12();
+    if (cur == peb) return;
+    ((void **)teb)[0x348 / 8] = cur;
+    __asm__ volatile( "movq %0,%%gs:0x60" :: "r" (peb) );
+}
+static inline void mac_slot12_to_unix( void *teb )
+{
+    if (mac_tsd12() != ((void **)teb)[0x60 / 8]) return;
+    __asm__ volatile( "movq %0,%%gs:0x60" :: "r" (((void **)teb)[0x348 / 8]) );
+}
 #endif
 
